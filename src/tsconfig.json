{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"esModuleInterop": true,
		"removeComments": false,
		"preserveConstEnums": true,
		"sourceMap": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"isolatedModules": false,
		"skipLibCheck": true,
		"outDir": "../out/vs",
		"types": [
			"@webgpu/types",
			"mocha",
			"semver",
			"sinon",
			"trusted-types",
			"winreg",
			"wicg-file-system-access"
		],
		"plugins": [
			{
				"name": "tsec",
				"exemptionConfig": "./tsec.exemptions.json"
			}
		]
	},
	"include": [
		"./*.ts",
		"./typings",
		"./vs/**/*.ts",
		"./vscode-dts/vscode.proposed.*.d.ts",
		"./vscode-dts/vscode.d.ts"
	],
	"exclude": [
		"vs/workbench/contrib/webview/browser/pre/service-worker.js",
		"vs/platform/agentHost",
		"vs/platform/browserView/node",
		"vs/platform/browserView/electron-main",
		"vs/workbench/contrib/browserView",
		"vs/platform/agentHost/node/sshRemoteAgentHostService.ts",
		"vs/platform/agentHost/node/tunnelAgentHostService.ts",
		"vs/platform/agentHost/node/tunnelHostMainService.ts",
		"vs/workbench/test/browser/componentFixtures",
		"vs/workbench/test/electron-browser/workbenchTestServices.ts",
		"vs/platform/browserView",
		"vs/platform/sandbox/node/sandboxHelper.ts"
	]
}
